# Copy to .env (local) or add as GitHub Actions secrets/variables. Never commit real values.

# --- Database (Supabase → Project Settings → Database → Connection string, "Session pooler") ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- LLM (provider-agnostic) ---
LLM_PROVIDER=openai_compatible   # openai_compatible (free Gemini default) | openai | anthropic
LLM_API_KEY=                   # one key for whichever provider (free: aistudio.google.com/apikey)
LLM_MODEL=                      # quality model for tailoring/writing
LLM_MODEL_FAST=                 # cheaper model for scoring/classification (optional; falls back to LLM_MODEL)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini free tier; or Groq/OpenRouter/Ollama
LLM_MIN_INTERVAL_S=4           # spacing between calls to stay under free-tier rate limits

# --- Job sources (each optional) ---
JSEARCH_API_KEY=                # RapidAPI JSearch — Google for Jobs (LinkedIn/Indeed/Glassdoor listings)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FIRECRAWL_API_KEY=              # web search + page reading

# --- Google (Gmail + Calendar), see scripts/google_oauth.py ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OWNER_EMAIL=

# --- Notion (optional projection) ---
NOTION_TOKEN=
NOTION_APPLICATIONS_DB=

# --- Alerts ---
NTFY_TOPIC=                     # iPhone push: install the free "ntfy" app, subscribe to this topic. Use a long random name — anyone who knows it can read it
TWILIO_ACCOUNT_SID=             # optional SMS for urgent alerts (CAPTCHA, interview, offer)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=                    # E.164, e.g. +91XXXXXXXXXX
HUMAN_WAIT_SECONDS=120          # how long to wait for you on any human step (CAPTCHA, code, sign-in, question) before moving on
OWNER_TIMEZONE=Asia/Kolkata

# --- Safety switches: everything outbound is off until you flip these ---
DRY_RUN=true
SUBMIT_ENABLED=false
EMAIL_ENABLED=false
